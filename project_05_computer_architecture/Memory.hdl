// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
//
// File name: projects/05/Memory.hdl


CHIP Memory {

    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Select RAM or I/O region.
    // address[14]=0 -> RAM16K
    // address[14]=1 -> Screen/Keyboard
    DMux(in=load,sel=address[14],a=ramload,b=skload);


    // Select Screen or Keyboard.
    // address[13]=0 -> Screen
    // address[13]=1 -> Keyboard
    DMux(in=skload,sel=address[13],a=sload,b=nothing);


    // RAM occupies addresses 0 - 16383.
    RAM16K(
        in=in,
        load=ramload,
        address=address[0..13],
        out=ramout
    );


    // Screen memory mapped I/O.
    // Uses addresses 16384 - 24575.
    Screen(
        in=in,
        load=sload,
        address=address[0..12],
        out=screenout
    );


    // Keyboard is read-only and mapped to address 24576.
    Keyboard(out=kbd);


    // Check if lower address bits are zero.
    // Required to select only address 0x6000 for keyboard.
    Or8Way(in=address[0..7], out=notkbd1);

    Or8Way(
        in[0..4]=address[8..12],
        in[5..7]=false,
        out=notkbd2
    );

    Or(a=notkbd1,b=notkbd2,out=notkbd);


    // Output keyboard value only for valid keyboard address.
    Mux16(
        a=kbd,
        b=false,
        sel=notkbd,
        out=kbdout
    );


    // Select final memory output.
    // address[14]=0 -> RAM
    // address[14]=1 -> Screen/Keyboard
    Mux16(
        a=ramout,
        b=outsk,
        sel=address[14],
        out=out
    );


    // Select between Screen and Keyboard output.
    Mux16(
        a=screenout,
        b=kbdout,
        sel=address[13],
        out=outsk
    );

}